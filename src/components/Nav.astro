---
interface Props { path: string; }
const { path } = Astro.props;
const home = path === '/';
const links = [
  { label: 'Technology', href: '/technology' },
  { label: 'Roadmap',    href: '/roadmap' },
  { label: 'Investors',  href: '/investors' },
  { label: 'Contact',    href: home ? '#contact' : '/#contact' }
];
---
<header class="nav" id="nav">
  <div class="suite suite--flagship nav__inner">
    <!-- TruVector has no mark of its own yet, so the wordmark is typeset and the
         parent mark stands beside it. Replaced when the drawing is supplied. -->
    <a class="nav__brand" href="/" aria-label="TruVector — home">
      <img class="nav__mark" src="/assets/logos/intellme.svg" width="11" height="26" alt="" />
      <span class="nav__wordmark">TruVector</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => (
        <a class="nav__link" href={l.href}
           aria-current={l.href === path ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <button class="nav__toggle" type="button" id="drawer-open"
            aria-expanded="false" aria-controls="drawer">
      <span class="bars" aria-hidden="true"></span> Menu
    </button>
  </div>
</header>

<div class="drawer" id="drawer" hidden role="dialog" aria-modal="true" aria-label="Menu">
  <div class="suite drawer__head">
    <span class="nav__wordmark">TruVector</span>
    <button class="drawer__close" type="button" id="drawer-close">Close</button>
  </div>
  <div class="suite drawer__links">
    {links.map((l) => <a class="drawer__link" href={l.href}>{l.label}</a>)}
  </div>
</div>
