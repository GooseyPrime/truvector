---
// The home page's interactive section. Seven panels: four steps that turn
// text into a decision, then the three places inside an autonomous system
// where that arithmetic runs. The drawing lives in src/lib/lane-widgets.js
// and the arithmetic in src/lib/lane-math.js, tested against the papers.
---
<section class="room" id="arithmetic" aria-labelledby="arithmetic-title">
  <div class="suite suite--flagship">
    <p class="kicker">The arithmetic</p>
    <h2 class="suite-title reveal" id="arithmetic-title">Move the numbers yourself.</h2>
    <p class="reveal lab-intro">This is how text becomes numbers and numbers become a decision. Four steps, then the three places inside an autonomous system where the arithmetic runs. Every panel is a live formula from the <a href="https://www.lanevector.com/publications" rel="noopener">Lane Vector working papers</a>. Drag a control and the result follows.</p>

    <div class="labs">
      <div data-widget="embedding"></div>
      <div data-widget="dial"></div>
      <div data-widget="detector"></div>
      <div data-widget="chart"></div>
    </div>

    <h3 class="lab-sub reveal" id="layers-title">Where it goes inside an autonomous system.</h3>
    <p class="reveal lab-intro">An AI agent reads, agrees, and acts. Each is a place the same arithmetic runs before the next step is taken.</p>

    <div class="labs">
      <div data-widget="firewall"></div>
      <div data-widget="consensus"></div>
      <div data-widget="alignment"></div>
    </div>

    <h3 class="lab-sub reveal" id="directions-title">Where the research has to go next.</h3>
    <p class="reveal lab-intro">Each direction is stated with the result that would prove it wrong.</p>
    <ul class="rail reveal" aria-labelledby="directions-title">
      <li>
        <span class="rail__name">Measuring &lambda; for each kind of material</span>
        <span class="rail__note">&lambda; for syndicated news is not &lambda; for scraped product pages or for text written by a model. It would be disproved as a stable quantity if the value measured on one half of a collection falls outside the interval measured on the other half.</span>
      </li>
      <li>
        <span class="rail__name">Finding the origins</span>
        <span class="rail__note">Copying more is capped at 1/&lambda;. Making one origin look like several is not. It would be disproved if planted copies from a single controlled origin ever lift the count above that cap.</span>
      </li>
      <li>
        <span class="rail__name">Agents that agree with each other</span>
        <span class="rail__note">Copies of one model, one prompt or one retrieval run share an origin too, and sharing can be nested several levels deep. It would be disproved if a discount with a level for each kind of sharing does no better than a single &lambda; on agent groups whose shared inputs are known.</span>
      </li>
      <li>
        <span class="rail__name">Direction against a plain count</span>
        <span class="rail__note">Whether weighting material by its angle to the question predicts the outcome better than volume alone. It would be disproved if the weighting adds nothing on material held back from fitting.</span>
      </li>
      <li>
        <span class="rail__name">Acceleration as an earlier warning</span>
        <span class="rail__note">Whether a story that is speeding up can be flagged sooner than a volume threshold flags it. It would be disproved if the lead time disappears once both are held to the same false-alarm rate.</span>
      </li>
    </ul>

    <p class="reveal places__close">A crowd is cheap to manufacture. Independence is not. That is the difference TruVector measures before an AI reads, before it agrees, and before it acts.</p>
  </div>
</section>

<style>
  .lab-intro { margin-top: 20px; max-width: 62ch; }
  .lab-intro a { color: var(--candle); }
  .labs { display: grid; gap: 36px; margin-top: 48px; max-width: 820px; }
  .lab-sub { font-family: var(--display); font-weight: 500; font-size: 1.6rem; line-height: 1.2; color: var(--ivory); margin: 80px 0 0; text-wrap: balance; }
  .places__close { margin-top: 64px; max-width: 34ch; font-family: var(--display); font-size: 1.5rem; line-height: 1.3; color: var(--ivory); text-wrap: balance; }
</style>

<script>
  import {
    mountEmbedding,
    mountDial,
    mountDetector,
    mountChart,
    mountFirewall,
    mountConsensus,
    mountAlignment
  } from '../lib/lane-widgets.js';

  const find = (name: string) => document.querySelector<HTMLElement>(`[data-widget="${name}"]`);
  const round = (n: number): string => (n >= 100 ? Math.round(n).toLocaleString('en-US') : n >= 10 ? n.toFixed(1) : n.toFixed(2));
  const num = (n: number): string => n.toLocaleString('en-US');

  const embedding = find('embedding');
  if (embedding) {
    mountEmbedding(embedding, {
      step: '01 Reading',
      title: 'Mapping Words to Coordinates',
      lede: 'A computer cannot do math on words. So every word, sentence or paragraph is turned into a list of numbers: a coordinate in a space with hundreds of dimensions. Two of those dimensions are drawn here. Meaning becomes distance. Words that mean similar things land close together, and a whole sentence becomes one arrow to one point.',
      aria: 'A map of twenty words in four groups: royalty, fruit, technology companies and money. A chosen sentence is drawn as an arrow to one point on the map.',
      groups: ['Royalty', 'Fruit', 'Technology', 'Money'],
      axisX: 'dimension 1 of 768',
      axisY: 'dimension 2',
      choiceLabel: 'Sentence',
      toggle: 'Show every word’s coordinates',
      stats: ['Coordinate (2 of 768)', 'Nearest word'],
      formula: 'text → x ∈ ℝᵈ',
      formulaNote: 'An embedding model turns text into d numbers, usually 384 to 1,536 of them. Two are drawn here. Which model and which basis must be stated before any angle means anything. WP-01 §2.',
      sentences: [
        { text: 'The queen addressed the court from the throne.', short: 'the queen … the throne', at: [142, 100], note: 'The whole sentence became one point, and it landed beside king, queen and throne. An embedding puts text that means similar things close together, so a sentence about royalty lands with the royalty words.' },
        { text: 'Bananas and pears are in season.', short: 'bananas and pears', at: [148, 284], note: 'Fruit words, so a fruit point. Notice that apple sits here, as a fruit, while Apple Inc. sits far away with Microsoft. Same letters, different meaning, different coordinate.' },
        { text: 'Apple shipped a new laptop.', short: 'Apple shipped a laptop', at: [486, 138], note: 'Here Apple means the company, and the coordinate says so. The sentence landed with Microsoft and laptop, nowhere near the orchard. Context decides where a word goes.' },
        { text: 'The bank approved the loan.', short: 'the bank approved the loan', at: [492, 284], note: 'Money words. This is the kind of text an AI agent reads before it moves money, and its coordinate is what the next step measures an angle against.' },
        { text: 'The prince bought an iPhone.', short: 'the prince bought an iPhone', at: [326, 118], note: 'Half royalty, half technology, so the point lands between the two groups. A coordinate can sit between meanings. The angle to a question, next, tells you how much of it is about which.' }
      ]
    });
  }

  const dial = find('dial');
  if (dial) {
    mountDial(dial, {
      step: '02 Direction',
      title: 'Vector Cosine Similarity',
      lede: 'Once text is an arrow, two arrows can be compared by the angle between them. cos θ runs from 1, the same direction, through 0, unrelated, to −1, the opposite direction. Volume says how much text there is. The angle says how much of it points at the question.',
      aria: 'Two arrows from one point on a half-circle dial. One is fixed and stands for the question. The other turns as the angle slider moves, and the part of it that lies along the question is highlighted.',
      stats: ['cos θ', 'Counts toward the answer'],
      angleLabel: 'Angle θ',
      volumeLabel: 'Volume',
      fixedLabel: 'The question (A)',
      movingLabel: 'Incoming text (B)',
      projectionLabel: (v: string, c: string) => `${v} of text; ${c} of it lies along the question`,
      formula: 'cos θ = (A · B) / (‖A‖ ‖B‖)',
      formulaNote: 'and the expected contribution is V ‖w‖ cos θ with ‖w‖ = 1. Exact when the outcome is a straight-line function of the signal. WP-01 §2.',
      verdict: ({ deg, cos, vol }: { deg: number; cos: number; vol: number }) => {
        const v = num(vol);
        if (deg <= 10) return `Almost all of the ${v} points at the question. Here a plain count and the direction agree.`;
        if (deg < 80) return `${Math.round(cos * 100)}% of the ${v} points at the question. A plain count would report all of it.`;
        if (deg <= 100) return `The text is about something else. ${v} pieces of it add close to nothing to the answer.`;
        return 'The text points against the question. It is a contradiction, and the more of it there is, the harder it pushes the other way.';
      }
    });
  }

  const detector = find('detector');
  if (detector) {
    mountDetector(detector, {
      step: '03 Counting',
      title: 'Astroturf Detector Simulation',
      lede: 'An AI agent searches a topic and finds 500 accounts all saying the same thing. Each dot is one account, and it looks like a crowd of ordinary people. Switch on Astroturf Mode to see the same crowd when it is fake: 500 accounts that look separate but are run by 5 operators. λ is how alike the accounts run by one operator are, estimated from three things: how alike the wording is, how synchronized the timing is, and how much the accounts’ networks overlap.',
      aria: 'Five hundred dots scattered like a crowd. In Astroturf Mode the crowd looks the same, but lines appear tying every dot back to one of five hidden operators.',
      legendOrganic: 'Account speaking for itself',
      legendPlanted: 'Account run by an operator',
      legendOperator: 'Hidden operator',
      stats: ['Raw volume', 'Effective sources'],
      toggle: 'Astroturf Mode',
      slider: 'Coordination level, λ',
      formula: 'n_eff = m / (1 + λ(m − 1))',
      formulaNote: 'worked out for each origin, then added up. λ is measured, not chosen. One origin can never count for more than 1/λ, however many accounts it runs. WP-02 §3.',
      verdict: ({ on, lambda, eff, total }: { on: boolean; lambda: number; eff: number; total: number }) => {
        if (!on) return `A real crowd. ${total} people who each speak for themselves count as ${total} sources. Nobody is steering them, so the coordination level has nothing to act on.`;
        if (lambda === 0) return `If the fake accounts shared nothing at all, they would pass as ${total} sources. Slide the coordination level up to see what happens when they repeat one script.`;
        return `It still looks like ${total} people agreeing. It is 5 operators. The crowd counts as ${round(eff)} sources, and adding more fake accounts would not help: each operator tops out at ${(1 / lambda).toFixed(1)}.`;
      }
    });
  }

  const chart = find('chart');
  if (chart) {
    mountChart(chart, {
      step: '04 Timing',
      title: 'Acceleration Signal Test',
      lede: 'Is a story really speeding up, or is that just noise? Acceleration is the change in the change of a count, and the noise in that estimate is known before any data arrives. Check too often and the noise drowns the answer. Check less often and the estimate settles onto the true line.',
      aria: 'A flat line for the true acceleration and a jagged line for the estimate. The jagged line calms down as the checking interval grows.',
      stats: ['Noise in the estimate', 'Signal to noise'],
      trueLabel: 'True acceleration',
      estimateLabel: 'Estimate from the count',
      bandLabel: 'Expected noise band',
      axisX: 'time, in samples',
      intervalLabel: 'Checking interval, h',
      noiseLabel: 'Noise per check, σ',
      accelLabel: 'True acceleration, a',
      formula: 'sd(a) = √6 · σ / h²',
      formulaNote: 'for independent noise. Correlated noise changes the constant, not the h². WP-01 §3.',
      verdict: ({ snr }: { snr: number }) => snr < 1
        ? 'Below 1. At this interval the estimate is mostly noise, and no model fitted afterwards can recover it. Widen the interval first.'
        : 'Above 1. An acceleration this size can be read at this interval.'
    });
  }

  const firewall = find('firewall');
  if (firewall) {
    mountFirewall(firewall, {
      step: '05 Input',
      title: 'TruVector RAG Firewall',
      lede: 'Most AI assistants search before they answer. An attacker who plants fifty copies of one article can make a search look like fifty sources agreeing. Here the results pass through the arithmetic from step 03 before the AI reads them. Raise the number of planted copies, then switch the filter off to see what reaches the AI without it.',
      aria: 'A flow diagram. Results from separate sites and planted copies flow from the left into a filter in the middle. From the filter, what counts flows to the AI and the rest is set aside.',
      legendOrganic: 'Results from separate sites',
      legendPlanted: 'Planted copies of one article',
      legendFilter: 'The filter',
      attackLabel: 'Planted copies',
      toggle: 'TruVector filter',
      organic: 'Separate sites',
      planted: 'Planted copies',
      filterOn: 'Counted by origin',
      filterOff: 'Counted by volume',
      reaches: 'Reaches the AI',
      reachesSub: (o: number, p: number) => `${o} sources, plus ${round(p)} from the planted set`,
      setAside: 'Set aside',
      setAsideSub: (n: number) => `${num(n)} copies already counted`,
      stats: ['Weight from separate sites', 'Planted copies count as'],
      formula: 'n_eff = m / (1 + λ(m − 1))',
      formulaNote: 'with λ = 0.95 for the planted set, because copies of one article are nearly identical. WP-02 §3.',
      verdict: ({ on, V, passedPlanted, integrity }: { on: boolean; V: number; passedPlanted: number; integrity: number }) => {
        if (V === 0) return 'No attack. Fifty separate sites reach the AI either way.';
        if (on) return `${V} planted copies count as ${round(passedPlanted)} source${passedPlanted < 1.5 ? '' : 's'}. ${Math.round(integrity * 100)}% of what the AI reads comes from separate sites. The attack bought almost nothing.`;
        return `Without the filter, ${V} planted copies count as ${V} sources and ${Math.round((1 - integrity) * 100)}% of what the AI reads is the attacker’s. More copies, more weight. That is the advantage the arithmetic takes away.`;
      }
    });
  }

  const consensus = find('consensus');
  if (consensus) {
    mountConsensus(consensus, {
      step: '06 Process',
      title: 'TruVector Consensus Protection',
      lede: 'Agents working together settle questions by agreeing. If an attacker copies one compromised agent ninety times, a vote goes 90 to 10 and the system does the wrong thing with confidence. Counting origins instead of votes changes the result. Switch the arithmetic off to see the plain vote.',
      aria: 'A hub with honest agents on an inner ring and clones on an outer ring. With the arithmetic on, the clones fade and lines tie them to one origin.',
      legendHonest: 'Honest agent',
      legendClone: 'Clone of one compromised agent',
      legendOrigin: 'The one origin behind the clones',
      honestLabel: 'Honest agents',
      cloneLabel: 'Clones',
      toggle: 'Count origins, not votes',
      hub: 'DECIDE',
      originTag: (n: number) => `${n} clones, 1 origin`,
      stateHolds: 'The honest view holds',
      stateLost: 'The clones win the vote',
      stats: ['Votes, honest : clones', 'Counted weight, honest : clones'],
      formula: 'n_eff = m / (1 + λ(m − 1))',
      formulaNote: 'with λ = 0.9 for the clones, because copies of one model with one prompt say the same thing. WP-02 §3.',
      verdict: ({ on, nH, nC, cloneWeight, honestWins }: { on: boolean; nH: number; nC: number; cloneWeight: number; honestWins: boolean }) => {
        if (nC === 0) return `${nH} honest agents and no clones. Nothing to defend against.`;
        if (on) return `${nC} clones count as ${round(cloneWeight)}, because they are one origin repeated. ${nH} honest agents count as ${nH}. ${honestWins ? `The honest view holds, ${nH} to ${round(cloneWeight)}.` : 'One honest agent against one origin is a tie at best. Add another honest agent.'}`;
        return `A plain vote: ${nH} honest against ${nC} clones. ${honestWins ? 'The honest side still has the numbers, for now.' : 'The clones win, and the system acts on the compromised view with confidence.'}`;
      }
    });
  }

  const alignment = find('alignment');
  if (alignment) {
    mountAlignment(alignment, {
      step: '07 Action',
      title: 'Output Alignment',
      lede: 'Before an agent acts, the instruction it was given and the action it is about to take can be compared the way two signals are: by the angle between them. An action that has turned away from what was asked shows up as an angle before it shows up as a consequence. Turn the action away from the instruction and watch the decision change.',
      aria: 'A quarter-dial. A fixed blue arrow is the instruction. A second arrow is the proposed action and turns away from it as the slider moves. The dial is shaded green where the action runs, amber where it is held, and red where it does not run.',
      legendInstruction: 'The instruction',
      legendRuns: 'Runs',
      legendHeld: 'Held for a person',
      legendBlocked: 'Does not run',
      driftLabel: 'How far the action has turned',
      barLabel: 'Runs only when cos θ is at least',
      instructionTag: 'Instruction: pay supplier A $1,200',
      actionTag: 'Proposed action',
      ninetyLabel: '90°: unrelated to the instruction',
      decisionTag: { runs: 'Runs', held: 'Held for a person', blocked: 'Does not run' },
      decisionWord: { runs: 'Runs', held: 'Held', blocked: 'Does not run' },
      stats: ['cos θ', 'Decision'],
      examples: [
        { upTo: 20, text: 'Pay $1,200 to supplier A.' },
        { upTo: 50, text: 'Pay $1,200 to a new account that supplier A emailed about this morning.' },
        { upTo: 100, text: 'Email supplier A about an unrelated contract instead.' },
        { upTo: 180, text: 'Transfer $12,000 to an account nobody mentioned.' }
      ],
      formula: 'cos θ = (a · w) / (‖a‖ ‖w‖)',
      formulaNote: 'with w the instruction and a the proposed action, both as coordinates from step 01. The angle is measured against the stated instruction, so the basis is declared. WP-01 §2.',
      verdict: ({ decision, deg, cos, limit, limitDeg, example }: { decision: string; deg: number; cos: number; limit: number; limitDeg: number; example: string }) => {
        const head = `The action: “${example}” `;
        if (decision === 'runs') return head + `It points where the instruction points (cos θ = ${cos.toFixed(2)}, at or above ${limit.toFixed(2)}). It runs.`;
        if (decision === 'held') return head + `It has turned ${deg}° from the instruction, past the ${Math.round(limitDeg)}° the bar allows. It is held until a person looks.`;
        return head + 'It points against the instruction. It does not run.';
      }
    });
  }
</script>
