---
import Base from '../layouts/Base.astro';

const beats = [
  {
    date: 'Dec 2025',
    title: 'SEO intent expected-value model',
    body: 'The earliest line of work was an expected-value model for search intent: estimated demand times estimated conversion probability times estimated customer value. A high-volume phrase could still be a poor bet if it rarely converted.',
  },
  {
    date: 'Later',
    title: 'Kinematic vocabulary as analogy',
    body: 'Kinematic language entered as an analogy for how support shifts over time. It names a research question; it does not assert that information obeys conservation laws.',
  },
  {
    date: '2026',
    title: 'TruVector evidence arbitration',
    body: 'The work narrowed into TruVector: evidence arbitration before execution, with disagreement and independence kept attached to the decision rather than averaged away.',
  },
  {
    date: 'Current',
    title: 'Capability table',
    body: 'The current public boundary is the capability table: Implemented, Under validation, Planned, and Hypothesis stated exactly where each claim stands today.',
  }
];
---
<Base
  title="Lineage — TruVector"
  description="A short lineage of the TruVector idea from expected-value SEO intent work to the current evidence-arbitration capability table."
  path="/lineage"
>
  <section class="room" style="padding-top:96px;padding-bottom:56px" aria-labelledby="lineage-title">
    <div class="suite suite--flagship">
      <p class="kicker">Lineage</p>
      <h1 class="suite-title" id="lineage-title" style="max-width:21ch">Four short beats from precursor work to the current boundary.</h1>
      <hr class="rule--champagne" style="margin-top:32px" />
      <p class="hero-support" style="margin-top:28px;max-width:62ch">This is the short version of where the framing came from. Research notes live at <a href="https://www.lanevector.com" rel="noopener noreferrer">lanevector.com</a>, subordinate to this product site and to the InTellMe parent.</p>
    </div>
  </section>

  <hr class="rule" />

  <section class="room room--alt" aria-labelledby="beats-title">
    <div class="suite suite--flagship">
      <p class="kicker">Sequence</p>
      <h2 class="suite-title reveal" id="beats-title">Only the beats needed to understand the present.</h2>
      <ul class="rail reveal" style="margin-top:44px">
        {beats.map((beat) => (
          <li>
            <div class="product__meta" style="margin-bottom:8px">
              <span class="rail__name">{beat.title}</span>
              <span class="badge">{beat.date}</span>
            </div>
            <span class="rail__note">{beat.body}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
