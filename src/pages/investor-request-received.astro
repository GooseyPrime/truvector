---
import Base from '../layouts/Base.astro';
---
<Base title="Request received — TruVector"
      description="Your request has been received." path="/investor-request-received" noindex={true}>
  <section class="room" style="min-height:70svh;display:flex;align-items:center">
    <div class="suite suite--flagship">
      <p class="kicker">Received</p>
      <h1 class="suite-title" style="max-width:20ch">Thank you — it reached a person.</h1>
      <hr class="rule--champagne" style="margin-top:32px" />
      <p class="hero-support" style="margin-top:28px">Requests are read and answered individually, usually within a few days. If it is urgent, write directly to <a href="mailto:brandon@intellmeai.com">brandon@intellmeai.com</a>.</p>
      <div class="actions" style="margin-top:36px">
        <a class="btn btn--secondary" href="/">Back to TruVector</a>
      </div>
    </div>
  </section>
</Base>
