---
import Base from '../layouts/Base.astro';

const phases = [
  {
    n: 'Stage one',
    title: 'Core arbitration service',
    lede: 'TruVector as a deployable evidentiary checkpoint, self-contained and economically measurable.',
    delivers: [
      'Assertion evaluated against a stable corpus, returning the evidence object',
      'Allow · Review · Block boundary enforced in front of a downstream action',
      'Contradiction and independence detection running, calibration in progress',
      'Decision path logged in full, so any decision can be reconstructed later'
    ],
    shape: [
      'Stable corpus with breadth suitable for high-confidence arbitration',
      'Controlled ingestion cadence rather than continuous crawl',
      'Single-model evaluation; triangulation deliberately deferred'
    ],
    fit: 'Document arbitration, policy consistency checking, and pre-execution evaluation of AI output where a single well-scoped corpus is the authority.'
  },
  {
    n: 'Stage two',
    title: 'Multi-model triangulation',
    lede: 'Robustness through disagreement between models, not just between sources.',
    delivers: [
      'Evaluation across several models, with divergence between them scored',
      'Quorum built: how much independent agreement is required, scaled to what the action costs',
      'Inter-model variance surfaced in the evidence object as its own signal',
      'Authority recalibration on a schedule rather than at write time'
    ],
    shape: [
      'Corpus coverage expanded to support broader arbitration contexts',
      'Three-model minimum for an arbitrated decision',
      'Latency budget becomes a first-class constraint'
    ],
    fit: 'Reduces single-model bias, and makes the confidence figure mean something across model families rather than within one.'
  },
  {
    n: 'Stage three',
    title: 'Governance and scale',
    lede: 'From a controlled deployment to infrastructure other systems depend on.',
    delivers: [
      'Distributed arbitration across endpoints, with capability floors that prevent latency pressure from degrading the judgement',
      'Continuous drift monitoring, and the kinematic hypothesis either demonstrated or retired',
      'Audit surface built for a reviewer rather than for an engineer',
      'Operating characteristics documented well enough to be depended on'
    ],
    shape: [
      'High-volume distributed vector workloads',
      'Corpus scale an order of magnitude beyond stage two',
      'Governance and retention requirements treated as design inputs'
    ],
    fit: 'A pre-execution evaluation layer for autonomous systems, and a governance-ready arbitration service.'
  }
];
---
<Base
  title="Roadmap — TruVector"
  description="How TruVector moves from a self-contained arbitration service to distributed trust infrastructure, in three stages, each delivering capability on its own."
  path="/roadmap"
>

  <section class="room" style="padding-top:96px;padding-bottom:56px" aria-labelledby="rm-title">
    <div class="suite suite--flagship">
      <p class="kicker">Roadmap</p>
      <h1 class="suite-title" id="rm-title" style="max-width:24ch">Three stages, each useful on its own.</h1>
      <hr class="rule--champagne" style="margin-top:32px" />
      <p class="hero-support" style="margin-top:28px">TruVector is built in stages that compound rather than replace each other. Stage one is a complete service, not a prototype for stage two, and no stage requires the architecture to be redesigned for the next one to be possible.</p>
      <p class="caption" style="margin-top:24px">Sequence, not calendar. Dates are published when they are committed, and none are committed today.</p>
    </div>
  </section>

  <hr class="rule" />

  {phases.map((p, i) => (
    <section class={i % 2 === 1 ? 'room room--alt' : 'room'} aria-labelledby={`ph-${i}`}>
      <div class="suite suite--flagship">
        <p class="kicker">{p.n}</p>
        <h2 class="suite-title reveal" id={`ph-${i}`}>{p.title}</h2>
        <p class="lede reveal" style="margin-top:20px;max-width:60ch">{p.lede}</p>
        <div class="tracks reveal" style="margin-top:44px">
          <div class="track">
            <h3 class="room-title" style="font-size:1.1rem">What it delivers</h3>
            <ul>{p.delivers.map((d) => <li>{d}</li>)}</ul>
          </div>
          <div class="track">
            <h3 class="room-title" style="font-size:1.1rem">Operating shape</h3>
            <ul>{p.shape.map((s) => <li>{s}</li>)}</ul>
          </div>
        </div>
        <p class="reveal" style="margin-top:36px;padding-top:24px;border-top:1px solid var(--bronze-edge);max-width:64ch"><strong>Where it fits.</strong> {p.fit}</p>
      </div>
    </section>
  ))}

  <section class="room" aria-labelledby="integrity">
    <div class="suite suite--flagship">
      <p class="kicker">Architectural integrity</p>
      <h2 class="suite-title reveal" id="integrity">Nothing here requires a rewrite.</h2>
      <ul class="rail reveal" style="margin-top:44px">
        <li><span class="rail__note">Stage one operates as a self-contained arbitration service and is viable without either stage that follows.</span></li>
        <li><span class="rail__note">Stages two and three expand robustness and governance depth against the same interfaces.</span></li>
        <li><span class="rail__note">Capacity scales with resources without structural disruption, which is what makes the progression disciplined rather than experimental.</span></li>
      </ul>
      <p class="reveal" style="margin-top:40px;max-width:60ch">Capital requirements, capacity figures, and cost-per-assertion targets for each stage are in the investor materials rather than on this page, because they change faster than a public page should.</p>
      <div class="actions reveal" style="margin-top:32px">
        <a class="btn btn--primary" href="/investors#request">Request the full plan</a>
      </div>
    </div>
  </section>

</Base>
